# RiskWise Environment Variables Configuration
# Copy this file to .env for local adjustments. No secrets are required for offline startup!

# Server configuration
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database & Storage
DATABASE_URL=sqlite:///./riskwise.db
ARTIFACTS_DIR=./artifacts
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge

# Offline & Provider Fallback Modes
OFFLINE_MODE=true
MARKET_DATA_PROVIDER=offline_snapshot
USE_LOCAL_EMBEDDINGS=true

# Optional Hosted LLM Provider (Leave blank for offline deterministic fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
